---
import Base from "../layouts/Base.astro";
---

<Base
  title="Page not found"
  description="That page is not on agripulse.cloud. Start from the home page, or open the documentation."
>
  <section class="mx-auto max-w-content px-6 py-24 text-center">
    <p class="text-sm font-semibold uppercase tracking-[0.16em] text-leaf-600">404</p>
    <h1 class="mt-3 font-display text-4xl font-semibold tracking-tight text-ink">
      That page is not here.
    </h1>
    <p class="mx-auto mt-4 max-w-xl text-muted">
      The address may be old, or the page may have been renamed.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a
        href="/"
        class="rounded-lg bg-leaf-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-leaf-700"
        >Home</a
      >
      <a
        href="https://docs.agripulse.cloud"
        class="rounded-lg border border-sand-300 px-5 py-2.5 text-sm font-semibold text-ink hover:border-muted-soft"
        >Documentation</a
      >
      <a
        href="/contact"
        class="rounded-lg border border-sand-300 px-5 py-2.5 text-sm font-semibold text-ink hover:border-muted-soft"
        >Contact us</a
      >
    </div>
  </section>
</Base>
