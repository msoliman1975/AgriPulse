# Scout app configuration. Copy to `.env.local` for dev.

# Keycloak realm the app signs in against. The client is public + PKCE and is
# created by `python -m scripts.dev_keycloak_mobile_client` (backend/).
VITE_KEYCLOAK_ISSUER=http://localhost:8080/realms/agripulse
VITE_KEYCLOAK_CLIENT_ID=agripulse-mobile

# Dev proxies /api to :8000. A device build cannot use the proxy and must point
# at a reachable host — a phone's "localhost" is the phone.
VITE_API_BASE_URL=/api/v1

# A Scout's token carries exactly one farm scope today, so the farm is config.
VITE_FARM_ID=

# Arabic is the default; set to `en` only for development.
VITE_LANG=ar
