# Copy to keystore.properties (git-ignored) and fill in. Paths are relative to
# this android/ directory, or absolute.
storeFile=/path/to/agripulse-scout-release.p12
storePassword=CHANGE_ME
keyAlias=agripulse-scout
# PKCS12 keystores use one password for the store and the key; leave this
# equal to storePassword (or omit it).
keyPassword=CHANGE_ME
