# Scout app — PRODUCTION build. Committed on purpose (see .gitignore): these
# are public hostnames and a farm id, no secrets.
#
# Vite loads this for `vite build` (mode defaults to production) and it takes
# priority over `.env.local`, so a dev machine that still has `.env.local`
# pointing at 10.0.2.2 still produces a correct production APK. Mode-specific
# files outrank generic ones in Vite's resolution order — the trap would be
# `.env.production.local`, which outranks this one.
#
# Build with:
#   SCOUT_ENV=production pnpm build && SCOUT_ENV=production pnpm exec cap sync android
# SCOUT_ENV is read by capacitor.config.ts (the Capacitor CLI does not read
# .env files) and flips androidScheme to https so the WebView origin is
# https://localhost — the origin the api's CORS_ALLOWED_ORIGINS lists.

# The app only builds a token URL from this; it does not read discovery and
# does not validate `iss`. The api validates the issuer as an exact string, and
# prod is pinned to this value (infra/helm/api/values.yaml KEYCLOAK_ISSUER).
VITE_KEYCLOAK_ISSUER=https://keycloak.agripulse.cloud/realms/agripulse
VITE_KEYCLOAK_CLIENT_ID=agripulse-mobile

# Production api. Note the host is api.agripulse.cloud — app.agripulse.cloud
# serves the SPA and answers /api/* with index.html, so a 200 from there is not
# the api responding.
VITE_API_BASE_URL=https://api.agripulse.cloud/api/v1

# A Scout's token carries exactly one farm scope today, so the farm is config.
# The farm the prod demo Scout (demo-scout-r2@agripulse.tech) is scoped to.
VITE_FARM_ID=019ecf29-2832-7b5b-95df-9d7751d1c8dd

# Arabic is the default in the field.
VITE_LANG=ar
