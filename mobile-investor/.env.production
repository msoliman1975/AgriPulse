# Investor app, PRODUCTION build. Public hostnames only, no secrets.
#
# Build with:
#   INVESTOR_ENV=production pnpm build && INVESTOR_ENV=production pnpm exec cap sync android

VITE_KEYCLOAK_ISSUER=https://keycloak.agripulse.cloud/realms/agripulse

# Sign-in goes through the web client for now: Keycloak opens in the system
# browser, returns to a page on the web app, and that page hands the code to
# this app through the cloud.agripulse.investor:// link. PKCE keeps the code
# useless to anyone without this install's verifier. A dedicated
# `agripulse-investor` client with a direct app link replaces both values
# below once it exists in the production realm.
VITE_KEYCLOAK_CLIENT_ID=agripulse-api
VITE_KEYCLOAK_REDIRECT_URI=https://app.agripulse.cloud/investor-app/callback

# The api host. app.agripulse.cloud answers /api/* with index.html.
VITE_API_BASE_URL=https://api.agripulse.cloud/api/v1
