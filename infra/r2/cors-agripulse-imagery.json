{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://localhost",
          "http://localhost",
          "https://app.agripulse.cloud"
        ],
        "methods": ["PUT", "GET", "HEAD"],
        "headers": ["*"]
      },
      "exposeHeaders": ["ETag"],
      "maxAgeSeconds": 3600
    }
  ]
}
